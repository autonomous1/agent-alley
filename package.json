{
  "name": "agent-alley",
  "version": "0.1.0",
  "description": "A multi-role agent pipeline for model-driven development.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "agents",
    "src",
    "test",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node src/check.mjs",
    "self-check": "node src/self-check.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm run self-check && npm run test",
    "codemap": "node src/codemap.ts"
  },
  "bin": {
    "modev": "./src/cli.mjs"
  },
  "dependencies": {
    "typescript": "^5.8.2"
  }
}
