{
  "name": "agent-alley",
  "version": "0.1.0",
  "description": "A codebase model \u2014 generated codemap plus layered knowledge bases \u2014 with a query CLI and lints, for multi-role coding agents.",
  "keywords": [
    "coding-agents",
    "agent-pipeline",
    "codemap",
    "knowledge-base",
    "code-navigation",
    "llm-context",
    "developer-tools"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/autonomous1/agent-alley.git"
  },
  "homepage": "https://github.com/autonomous1/agent-alley#readme",
  "bugs": {
    "url": "https://github.com/autonomous1/agent-alley/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs"
  },
  "files": [
    "agents",
    "src",
    "test",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node src/check.mjs",
    "self-check": "node src/self-check.mjs",
    "test": "node --test test/*.test.mjs",
    "verify": "npm run check && npm run self-check && npm run test",
    "codemap": "node src/codemap.ts"
  },
  "bin": {
    "modev": "./src/cli.mjs"
  },
  "dependencies": {
    "typescript": "^5.8.2"
  }
}
